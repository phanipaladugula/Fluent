# Browser origin of the FastAPI server (no trailing slash).
# Local two-process run: talk to the API directly so leaderboard SSE is not buffered.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Used by Next.js rewrites when NEXT_PUBLIC_API_URL is empty (Docker Compose).
API_PROXY_TARGET=http://127.0.0.1:8000

# Railway / split hosting: set this at RUNTIME on the frontend service
# to the public backend URL, e.g. https://fluent-api.up.railway.app
# API_PUBLIC_URL=
