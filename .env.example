# Copy values into frontend/.env.local and backend/.env for a local (non-Docker) run.
# Docker Compose does not need this file; it sets the same values itself.

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000

# Backend
DATABASE_PATH=./data/lingo.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
